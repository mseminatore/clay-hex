// hex -- Hex encoding, decoding and hexdumps for byte strings
//
// Usage:
//   import("hex")
//
//   Hex encode("Hello") println        // 48656c6c6f
//   Hex decode("48656c6c6f") println   // Hello
//   Hex dump("Hello, world!") println  // 00000000: 4865 6c6c 6f2c 2077 6f72 6c64 21         Hello, world!
//
// A Clay String is a sequence of bytes, so these work on any data, NULs and
// non-ASCII text included: Hex encode("é") is "c3a9". A wrong argument (not a
// String) or bad hex raises a RuntimeError whose message says what was wrong.
//
// Every brick shares one set of top-level names with the program that imports
// it, so keep yours few and distinctive: typically just the objects you provide.
//
// Note for readers: inside a method, passing arguments to another method of the
// same object needs an explicit receiver, `self _hexByte(b)`. A bare
// `_hexByte(b)` is not a call: it reads `_hexByte` and then evaluates `(b)`.

Hex = Object clone {

    digits = "0123456789abcdef"

    // raise unless data is a String; who names the calling method in the message
    _need(data, who) {
        (data type == "String") ifFalse {
            raise("hex " + who + ": expects a String (got " + data type + ")")
        }
    }

    // one byte (0..255) -> its two hex digits
    _hexByte(b) {
        (digits slice(b / 16, b / 16 + 1)) + (digits slice(b % 16, b % 16 + 1))
    }

    // the 8-digit hex offset at the start of a dump line
    _offset(n) {
        (_hexByte(n / 16777216 % 256)) + (_hexByte(n / 65536 % 256)) +
        (_hexByte(n / 256 % 256)) + (_hexByte(n % 256))
    }

    // byte string -> hex
    encode(data) {
         _need(data, "encode")
        parts = []
        data bytes each { |b| parts push(_hexByte(b)) }
        parts join("")
    }

    // hex -> byte string. Digits can be upper or lower case; spaces, tabs and
    // line ends are skipped wherever they are ("48 65 6c", or a hex listing split
    // over lines). Any other character is an error, reported at its position in
    // the text you gave.
    decode(data) {
        _need(data, "decode")

        nibbles = []
        i = 0
        { i < data length } whileTrue {
            ch = data slice(i, i + 1)
            (((ch == " ") || (ch == "\t")) || ((ch == "\n") || (ch == "\r"))) ifFalse {
                nibble = digits indexOf(ch lower)
                (nibble < 0) ifTrue { raise("hex decode: invalid digit at position ${i}") }
                nibbles push(nibble)
            }
            i = i + 1
        }
        (nibbles size % 2 != 0) ifTrue { raise("hex decode: odd-length input") }

        out = []
        k = 0
        { k < nibbles size } whileTrue {
            out push((nibbles at(k)) * 16 + (nibbles at(k + 1)))
            k = k + 2
        }

        String fromBytes(out)
    }

    // an xxd-like listing, 16 bytes per line: 8-digit offset, the bytes in
    // pairs, then the printable ASCII ("." for anything else)
    //   00000000: 4865 6c6c 6f  Hello
    dump(data) {
        _need(data, "dump")
        values = data bytes
        lines = []
        i = 0
        { i < values size } whileTrue {
            chunk = values slice(i, i + 16)

            // the bytes as hex, two to a group
            cells = chunk map { |b| _hexByte(b) }
            groups = []
            j = 0
            { j < cells size } whileTrue {
                pair = cells at(j)
                (j + 1 < cells size) ifTrue { pair = pair + (cells at(j + 1)) }
                groups push(pair)
                j = j + 2
            }

            // the printable column
            ascii = ""
            chunk each { |b|
                ascii = ascii + (((b >= 32) && (b < 127)) ifTrue { String fromBytes([b]) } ifFalse { "." })
            }

            lines push((_offset(i)) + ": " + (groups join(" ") padRight(39, " ")) + "  " + ascii)
            i = i + 16
        }

        lines join("\n")
    }
}
